# ── .state/.gitignore ──
# Track structure (start.md manifests), ignore accumulation.
# State is instance-specific — only the skeleton travels with the framework.

# Ignore everything
*

# Keep directory tree
!*/

# Keep manifests and this gitignore
!start.md
!.gitignore

# mileqa run sandboxes are disposable full-tree clones for isolated testing —
# their start.md copies are scratch, not manifests; re-exclude after the blanket keep above
tests/mileqa/*/sb/
