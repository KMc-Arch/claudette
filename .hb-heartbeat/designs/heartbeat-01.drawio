        <mxCell id="p2_e3" edge="1" parent="1" source="p2_tick" target="p2_run" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value="runs it in-process &amp;mdash; the tick &lt;b&gt;is&lt;/b&gt; the runner while an item runs">
