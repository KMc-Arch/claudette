        <mxCell id="p2_e2" edge="1" parent="1" source="p2_sched" target="p2_tick" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="fires every 5 min, but only for the window&#39;s length">
          <mxGeometry relative="1" as="geometry">
