        </mxCell>
        <mxCell id="p2_e16" edge="1" parent="1" source="p2_run" target="p2_a_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="pops one &amp;mdash; the move is the claim">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1560" y="236" />
              <mxPoint x="20" y="236" />
              <mxPoint x="20" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e17" edge="1" parent="1" source="p2_run" target="p2_a_quota" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="reads it before the pop, never after">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1620" y="264" />
              <mxPoint x="2060" y="264" />
              <mxPoint x="2060" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e18" edge="1" parent="1" source="p2_work" target="p2_a_commits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value="commits">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e19" edge="1" parent="1" source="p2_work" target="p2_a_result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="writes, before it stops">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1706" y="345" />
              <mxPoint x="1706" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e20" edge="1" parent="1" source="p2_work" target="p2_c_github" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=cross;fontSize=10;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;may not&lt;/b&gt; push, merge, close or approve">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1734" y="368" />
              <mxPoint x="1734" y="1020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e21" edge="1" parent="1" source="p2_work" target="p2_c_live" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=cross;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" value="&lt;b&gt;may not&lt;/b&gt; touch the flag, the queues, or anything outside its worktree">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2074" y="345" />
              <mxPoint x="2074" y="850" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e22" edge="1" parent="1" source="p2_sl" target="p2_a_quota" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value="dumps rate_limits on every turn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_e23" edge="1" parent="1" source="p2_human" target="p2_a_go" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="deletes it &amp;mdash; the kill switch, and nothing re-arms until the next scheduled open">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="222" />
              <mxPoint x="714" y="222" />
              <mxPoint x="714" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e24" edge="1" parent="1" source="p2_human" target="p2_a_outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="reads in the morning &amp;mdash; the inbox is read by a person and by nothing else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="1240" />
              <mxPoint x="1340" y="1240" />
              <mxPoint x="1340" y="845" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_e25" edge="1" parent="1" source="p2_human" target="p2_c_github" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" value="merges &amp;mdash; awake, by hand, the one act no machine here may perform">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="1290" />
              <mxPoint x="1550" y="1290" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hb-flow" name="3 · One night, end to end">
    <mxGraphModel dx="2550" dy="1717" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;heartbeat &amp;middot; one night, end to end&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;two chains &amp;mdash; the night, and the single item that runs inside one tick of it&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="2380" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p3_self" parent="1" style="whiteSpace=wrap;html=1;shape=note;fillColor=#8c8c8c;strokeColor=default;fontColor=default;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=22;spacingTop=8;shadow=1;" value="&lt;b&gt;this page&lt;/b&gt;&lt;br&gt;&lt;i&gt;Order and outcome. The chevrons carry the sequence, so they take no arrows between them.&lt;/i&gt;&lt;br&gt;&lt;i&gt;Who performs each stage is on page 2; what each stage writes is on page 5. The rollout is capped at one item a night, so the second chain runs once, then the caps stop the night.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="80" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_reading" parent="1" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;fontColor=default;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;WHAT MAKES A TICK CHEAP&lt;/b&gt;&lt;br&gt;&lt;i&gt;A tick that finds no flag exits without reading the queue, the quota or the backlog, and writes nothing but a timestamp. That is the whole point of the flag: exhaustion, a closed window and a kill switch all cost the same nothing, because the expensive machinery is only reached through a token that something else had to grant.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AND WHAT KEEPS IT SERIAL&lt;/b&gt;&lt;br&gt;&lt;i&gt;The claim is a rename, so exactly one tick can win it; the runner then holds it for the item&#39;s whole life. Nothing schedules a second item beside the first.&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="900" x="560" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_bandA" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;THE NIGHT&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;deterministic from end to end &amp;mdash; not one model call in this chain&lt;/font&gt;" vertex="1">
          <mxGeometry height="36" width="900" x="80" y="264" as="geometry" />
        </mxCell>
        <mxCell id="p3_a1" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;window open&lt;/b&gt;&lt;br&gt;issue GO, sweep orphans, prune worktrees, start a fresh ledger &amp;mdash; and refuse if the clock is outside the window" vertex="1">
          <mxGeometry height="100" width="300" x="80" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a2" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;tick&lt;/b&gt;&lt;br&gt;read the flag and nothing else; absent means exit in silence" vertex="1">
          <mxGeometry height="100" width="300" x="340" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a3" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;claim&lt;/b&gt;&lt;br&gt;go &amp;#8594; inflight by rename, before anything is spawned &amp;mdash; the tick claims, the runner only annotates" vertex="1">
          <mxGeometry height="100" width="300" x="600" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a4" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;one item runs&lt;/b&gt;&lt;br&gt;&lt;i&gt;the chain below happens here, inside this one tick&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="300" x="860" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a5" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;later ticks&lt;/b&gt;&lt;br&gt;count cap reached? within an item cap of the close? past the close? &amp;mdash; then do nothing, quietly" vertex="1">
          <mxGeometry height="100" width="300" x="1120" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a6" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;window close&lt;/b&gt;&lt;br&gt;corpse sweep, orphan sweep &amp;mdash; but a runner still alive is left to finish; nothing is killed mid-item" vertex="1">
          <mxGeometry height="100" width="300" x="1380" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_a7" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the summary&lt;/b&gt;&lt;br&gt;one file per night into the inbox, whatever happened &amp;mdash; including nothing" vertex="1">
          <mxGeometry height="100" width="300" x="1640" y="310" as="geometry" />
        </mxCell>
        <mxCell id="p3_bandB" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;ONE ITEM&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;the only stage where a model runs is the fourth&lt;/font&gt;" vertex="1">
          <mxGeometry height="36" width="900" x="80" y="474" as="geometry" />
        </mxCell>
        <mxCell id="p3_b1" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;quota gate&lt;/b&gt;&lt;br&gt;a reading older than its age limit counts as no reading at all" vertex="1">
          <mxGeometry height="100" width="300" x="80" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b2" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;pop&lt;/b&gt;&lt;br&gt;highest priority, oldest approval first; anything malformed is rejected, never guessed at" vertex="1">
          <mxGeometry height="100" width="300" x="340" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b3" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;provision&lt;/b&gt;&lt;br&gt;worktree from a pinned base, untracked work state copied in, the deny overlay written" vertex="1">
          <mxGeometry height="100" width="300" x="600" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b4" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;spawn the worker&lt;/b&gt;&lt;br&gt;its own process group, no credentials, capped at min(item, config) &amp;mdash; killed as a group at the wall" vertex="1">
          <mxGeometry height="100" width="300" x="860" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b5" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;harvest&lt;/b&gt;&lt;br&gt;the worker&#39;s files are read as data: regular files only, bounded, decoded leniently" vertex="1">
          <mxGeometry height="100" width="300" x="1120" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b6" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;classify&lt;/b&gt;&lt;br&gt;a kill at the cap, or a wall hit, outranks whatever the worker wrote about itself" vertex="1">
          <mxGeometry height="100" width="300" x="1380" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b7" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;publish&lt;/b&gt;&lt;br&gt;scrub the messages, the paths and the title, then push; scrub the body, then open the PR" vertex="1">
          <mxGeometry height="100" width="300" x="1640" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b8" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;outcome&lt;/b&gt;&lt;br&gt;write the folder a person will read tomorrow &amp;mdash; before the flag moves" vertex="1">
          <mxGeometry height="100" width="300" x="1900" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_b9" parent="1" style="whiteSpace=wrap;html=1;shape=step;perimeter=stepPerimeter;size=0.133;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;release&lt;/b&gt;&lt;br&gt;hand the token back, or hand it in &amp;mdash; see the six ways this ends, below" vertex="1">
          <mxGeometry height="100" width="300" x="2160" y="520" as="geometry" />
        </mxCell>
        <mxCell id="p3_runner" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the runner&lt;/b&gt;&lt;br&gt;&lt;i&gt;its only control-flow question: did I reach an expected terminus?&lt;/i&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="80" y="740" as="geometry" />
        </mxCell>
        <mxCell id="p3_t1" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;converged&lt;/b&gt;&lt;br&gt;&lt;i&gt;expected&lt;/i&gt;&lt;br&gt;branch pushed, PR opened, item filed in the inbox, worktree removed&lt;br&gt;&lt;b&gt;flag &amp;#8594; go&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="420" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_t2" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;exhausted&lt;/b&gt;&lt;br&gt;&lt;i&gt;expected&lt;/i&gt;&lt;br&gt;QA hit its bound instead of converging &amp;mdash; handled identically, and the outcome says which it was&lt;br&gt;&lt;b&gt;flag &amp;#8594; go&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="760" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_t3" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;cap&lt;/b&gt;&lt;br&gt;&lt;i&gt;expected&lt;/i&gt;&lt;br&gt;the worker was killed at the wall clock; whatever it had committed still publishes&lt;br&gt;&lt;b&gt;flag &amp;#8594; go&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="1100" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_t4" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;quota&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;not&lt;/b&gt; expected &amp;mdash; the gate cleared and the wall was hit anyway, so the sizing was wrong&lt;/i&gt;&lt;br&gt;a diagnostic written with no model call, item requeued&lt;br&gt;&lt;b&gt;flag &amp;#8594; absent: the night stops&lt;/b&gt;" vertex="1">
          <mxGeometry height="150" width="300" x="1440" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_t5" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;unexpected&lt;/b&gt;&lt;br&gt;&lt;i&gt;no terminus written, or the runner itself died&lt;/i&gt;&lt;br&gt;sandbox kept for forensics, item left in flight, &lt;b&gt;flag left in flight&lt;/b&gt; &amp;mdash; the sweep at close is what clears it, and it is loud" vertex="1">
          <mxGeometry height="150" width="300" x="1780" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_t6" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.15;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;rejected&lt;/b&gt; &amp;middot; &lt;b&gt;failed-repeatedly&lt;/b&gt;&lt;br&gt;malformed frontmatter, or the attempt ceiling reached&lt;br&gt;straight to the inbox as a bug report &amp;mdash; nothing retries for ever" vertex="1">
          <mxGeometry height="150" width="300" x="2120" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="p3_rule" parent="1" style="whiteSpace=wrap;html=1;shape=parallelogram;perimeter=parallelogramPerimeter;flipH=1;size=0.044;spacingLeft=50;spacingRight=50;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;Every path ends with the token handed back, handed in, or left as a corpse the sweep will clear.&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;No path leaves the night armed and idle, and no path relaunches into a failure it cannot explain.&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="900" x="80" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="p3_e1" edge="1" parent="1" source="p3_runner" target="p3_t1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="the worker said so">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="132" y="880" />
              <mxPoint x="570" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e2" edge="1" parent="1" source="p3_runner" target="p3_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="the worker said so">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="171" y="896" />
              <mxPoint x="910" y="896" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e3" edge="1" parent="1" source="p3_runner" target="p3_t3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="I killed it at the cap">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="210" y="912" />
              <mxPoint x="1250" y="912" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e4" edge="1" parent="1" source="p3_runner" target="p3_t4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="the error smells of the wall">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="249" y="928" />
              <mxPoint x="1590" y="928" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e5" edge="1" parent="1" source="p3_runner" target="p3_t5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;" value="anything else">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="288" y="944" />
              <mxPoint x="1930" y="944" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_e6" edge="1" parent="1" source="p3_runner" target="p3_t6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="never even started, or started three times">
          <mxGeometry relative="1" as="geometry">
