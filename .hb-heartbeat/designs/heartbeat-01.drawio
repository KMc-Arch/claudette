        </mxCell>
        <mxCell id="p1_e_roots" edge="1" parent="1" source="p1_mail" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandatoryOne;startFill=0;endArrow=ERoneToMany;endFill=0;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p1_cl_roots" value="one pair per root">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2020" y="721" />
              <mxPoint x="2020" y="1000" />
