  </diagram>
  <diagram id="hb-actors" name="2 · Actors &amp; acts">
    <mxGraphModel dx="2550" dy="1717" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;heartbeat &amp;middot; actors and acts&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;seven doers, what each one makes, and the two things the worker is barred from&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="2280" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p2_self" parent="1" style="whiteSpace=wrap;html=1;shape=note;fillColor=#8c8c8c;strokeColor=default;fontColor=default;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=22;spacingTop=8;shadow=1;" value="&lt;b&gt;this page&lt;/b&gt;&lt;br&gt;&lt;i&gt;Every doer in the system and every artifact it writes. Ordering is off this page (page 3); the flag&#39;s states are off it too (page 4).&lt;/i&gt;&lt;br&gt;&lt;i&gt;A column holds what the agent above it makes. An arrow that crosses columns is an agent reaching another agent&#39;s artifact.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="420" x="80" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_thesis" parent="1" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;fontColor=default;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;THE ASYMMETRY THIS PAGE EXISTS TO SHOW&lt;/b&gt;&lt;br&gt;&lt;i&gt;Six of the seven doers are deterministic programs. One &amp;mdash; the worker &amp;mdash; is a model, and it is the only doer that is not trusted: it holds no credential, writes nothing outside its own worktree, and reaches the outside world only through what the runner harvests from it. The runner does every live-state write and every remote write on its behalf; the human does the two acts no machine may do &amp;mdash; &lt;b&gt;approve&lt;/b&gt; and &lt;b&gt;merge&lt;/b&gt;.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="880" x="540" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_human" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the human&lt;/b&gt;&lt;br&gt;&lt;i&gt;awake, in the morning&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="80" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_sched" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;i&gt;the clock; the only thing that wakes the machine&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="420" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_det" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;window detector&lt;/b&gt;&lt;br&gt;&lt;i&gt;hb.py window open|close&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="760" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_tick" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;heartbeat tick&lt;/b&gt;&lt;br&gt;&lt;i&gt;hb.py tick &amp;mdash; reads the flag and nothing else&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="1100" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_run" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;the runner&lt;/b&gt;&lt;br&gt;&lt;i&gt;runner.py &amp;mdash; every live-state and remote write happens here&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="1440" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_work" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;the worker&lt;/b&gt;&lt;br&gt;&lt;i&gt;a model, hard-rooted in the sandbox, holding no credential&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="1780" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_sl" parent="1" style="whiteSpace=wrap;html=1;ellipse;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;statusLine&lt;/b&gt;&lt;br&gt;&lt;i&gt;fires on every turn of every interactive session&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="2120" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_item" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;an approved item&lt;/b&gt;&lt;br&gt;~outbox/hb/&amp;lt;ID&amp;gt;.md &amp;mdash; frontmatter plus a brief written for a cold reader" vertex="1">
          <mxGeometry height="110" width="280" x="50" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_night" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the nightly summary&lt;/b&gt;&lt;br&gt;~inbox/hb/night-&amp;lt;date&amp;gt;.md &amp;mdash; written every night, so a quiet night and a dead scheduler stop looking alike" vertex="1">
          <mxGeometry height="110" width="280" x="390" y="630" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_diag" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;a diagnostic&lt;/b&gt;&lt;br&gt;state/diag/ &amp;mdash; corpse &amp;middot; quota-exhausted &amp;middot; unexpected-terminus &amp;middot; provision-failed &amp;middot; runner-crash" vertex="1">
          <mxGeometry height="110" width="280" x="390" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_go" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;the GO flag&lt;/b&gt;&lt;br&gt;state/GO &amp;mdash; the permission token. No flag, no orchestration. Deleting it is the kill switch." vertex="1">
          <mxGeometry height="110" width="280" x="730" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_lasttick" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;last-tick&lt;/b&gt;&lt;br&gt;state/last-tick &amp;mdash; a timestamp, not a log line: proof the schedule fired" vertex="1">
          <mxGeometry height="110" width="280" x="1070" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p2_c_sandbox" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the sandbox worktree&lt;/b&gt;&lt;br&gt;&lt;i&gt;see 1 &amp;middot; Deployment&lt;/i&gt;" vertex="1">
          <mxGeometry height="130" width="280" x="1410" y="460" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_prompt" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the worker&#39;s brief&lt;/b&gt;&lt;br&gt;PROMPT.md &amp;mdash; rules, the outcome contract, and the item fenced as data" vertex="1">
          <mxGeometry height="110" width="280" x="1410" y="630" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_outcome" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the outcome folder&lt;/b&gt;&lt;br&gt;~inbox/hb/&amp;lt;ID&amp;gt;/ &amp;mdash; outcome.md &amp;middot; context.md &amp;middot; state.md &amp;middot; item.md &amp;middot; state-delta.diff" vertex="1">
          <mxGeometry height="110" width="280" x="1410" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p2_c_github" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;the branch and the pull request" vertex="1">
          <mxGeometry height="140" width="280" x="1410" y="950" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_commits" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;commits&lt;/b&gt;&lt;br&gt;on hb/&amp;lt;ID&amp;gt;, in the worktree &amp;mdash; early and often, so a kill at the cap still leaves a reviewable branch" vertex="1">
          <mxGeometry height="110" width="280" x="1750" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_result" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;RESULT&lt;/b&gt;&lt;br&gt;outcome.md (terminus &amp;middot; qa_result &amp;middot; summary) &amp;middot; context.md &amp;middot; state.md &amp;mdash; the only thing harvested besides the branch" vertex="1">
          <mxGeometry height="110" width="280" x="1750" y="630" as="geometry" />
        </mxCell>
        <mxCell id="p2_c_live" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;live state&lt;/b&gt;&lt;br&gt;the flag, the queues, the tree outside the sandbox&lt;br&gt;&lt;i&gt;see 4 and 6&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="1750" y="790" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_quota" parent="1" style="whiteSpace=wrap;html=1;shape=document;size=0.18;spacingBottom=10;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the quota reading&lt;/b&gt;&lt;br&gt;state/quota.json &amp;mdash; rate_limits plus written_at. Stale by nature: nothing headless writes it." vertex="1">
          <mxGeometry height="110" width="280" x="2090" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p2_e1" edge="1" parent="1" source="p2_sched" target="p2_det" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" value="fires 00:30 and 06:30">
