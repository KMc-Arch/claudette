          </mxGeometry>
        </mxCell>
        <mxCell id="p1_e_origin" edge="1" parent="1" source="p1_apex" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=8 8;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p1_cl_gh" value="origin &amp;mdash; fetched by anyone, written only by the runner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_api" edge="1" parent="1" source="p1_claude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=8 8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="p1_cl_api" value="the model resolves here">
