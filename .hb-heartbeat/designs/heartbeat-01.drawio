<mxfile host="Electron" pages="7">
  <diagram id="hb-deploy" name="1 · Deployment">
    <mxGraphModel dx="1800" dy="1212" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" parent="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;heartbeat &amp;middot; deployment&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;where the thing lives and what runs where &amp;middot; as built 2026-08-16, branch feature/hb&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1900" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1_self" parent="1" style="whiteSpace=wrap;html=1;shape=note;fillColor=#8c8c8c;strokeColor=default;fontColor=default;align=left;verticalAlign=top;fontSize=11;spacingLeft=10;spacingRight=22;spacingTop=8;shadow=1;" value="&lt;b&gt;this page&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Altitude: the machine and the tree. Boxes here are places and things, not doers &amp;mdash; no agent appears, so no act is drawn.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Deliberately off this page: who does what (page 2), the ordered night (page 3), the flag and the queue (page 4), the records (page 5), the controls (page 6), the decisions (page 7).&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;The seam: a deployment is the one register where the drawing can be wrong and the running host right. Re-read the host before trusting a version below.&lt;/i&gt;" vertex="1">
          <mxGeometry height="290" width="420" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_versions" parent="1" style="whiteSpace=wrap;html=1;fillColor=default;strokeColor=default;fontColor=default;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;VERSIONS AS BUILT&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#666666&quot;&gt;&lt;i&gt;measured on the host, 2026-08-16&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Windows PowerShell 5.1 &amp;middot; ANSI code page 1252&lt;br&gt;WSL2 kernel 6.6.87.2 &amp;middot; distro &lt;b&gt;claude-context&lt;/b&gt;&lt;br&gt;python 3.12.3 &amp;middot; PyYAML 6.0.1&lt;br&gt;git 2.43 &amp;middot; &lt;b&gt;core.fileMode = false&lt;/b&gt; on this mount&lt;br&gt;claude 2.1.233 &amp;middot; gh authenticated as KMc-Arch&lt;br&gt;&lt;br&gt;&lt;i&gt;Two consequences already paid for: a tracked script loses its execute bit on checkout (the scrub pre-push hook was silently ignored until the runner chmod&#39;d it), and a non-ASCII byte in a .ps1 stops Windows PowerShell parsing the file at all.&lt;/i&gt;" vertex="1">
          <mxGeometry height="290" width="420" x="80" y="410" as="geometry" />
        </mxCell>
        <mxCell id="p1_host" parent="1" style="swimlane;html=1;startSize=26;whiteSpace=wrap;fillColor=default;strokeColor=default;fontColor=default;swimlaneFillColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;WINDOWS HOST&lt;/b&gt;&amp;nbsp;&amp;nbsp;Task Scheduler &amp;middot; S4U principal, no logged-on session" vertex="1">
          <mxGeometry height="330" width="620" x="560" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_t_open" parent="p1_host" style="whiteSpace=wrap;html=1;shape=process;size=0.05;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;hb-window-open&lt;/b&gt;&lt;br&gt;daily 00:30 &amp;middot; WakeToRun" vertex="1">
          <mxGeometry height="64" width="280" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_t_close" parent="p1_host" style="whiteSpace=wrap;html=1;shape=process;size=0.05;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;hb-window-close&lt;/b&gt;&lt;br&gt;daily 06:30 &amp;middot; WakeToRun" vertex="1">
          <mxGeometry height="64" width="280" x="320" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_t_tick" parent="p1_host" style="whiteSpace=wrap;html=1;shape=process;size=0.024;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;hb-tick&lt;/b&gt;&amp;nbsp;&amp;nbsp;every 5 min, repeating &lt;b&gt;only for the window&#39;s length&lt;/b&gt; from 00:32&lt;br&gt;ExecutionTimeLimit = item cap + 15 min &amp;middot; MultipleInstances = IgnoreNew" vertex="1">
          <mxGeometry height="64" width="580" x="20" y="124" as="geometry" />
        </mxCell>
        <mxCell id="p1_runtick" parent="p1_host" style="whiteSpace=wrap;html=1;shape=process;size=0.024;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;win/run-tick.ps1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;the tick&#39;s action&lt;/i&gt;&lt;br&gt;holds SetThreadExecutionState(SYSTEM_REQUIRED) so Modern Standby cannot suspend the host mid-item&lt;br&gt;then: wsl.exe -d claude-context -u KMc -- python3 hb.py tick &amp;middot; exit code relayed, default 1" vertex="1">
          <mxGeometry height="96" width="580" x="20" y="208" as="geometry" />
        </mxCell>
        <mxCell id="p1_wsl" parent="1" style="swimlane;html=1;startSize=26;whiteSpace=wrap;fillColor=default;strokeColor=default;fontColor=default;swimlaneFillColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;WSL2&lt;/b&gt;&amp;nbsp;&amp;nbsp;distro claude-context &amp;middot; a fresh instance per wsl.exe call when nobody is logged in" vertex="1">
          <mxGeometry height="330" width="740" x="1240" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p1_py" parent="p1_wsl" style="whiteSpace=wrap;html=1;shape=process;size=0.041;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;python3&lt;/b&gt;&lt;br&gt;the whole control plane runs here" vertex="1">
          <mxGeometry height="64" width="340" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_claude" parent="p1_wsl" style="whiteSpace=wrap;html=1;shape=process;size=0.041;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;claude&lt;/b&gt;&amp;nbsp;&amp;nbsp;headless&lt;br&gt;spawned only by cboot.py, rooted at the sandbox" vertex="1">
          <mxGeometry height="64" width="340" x="380" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_git" parent="p1_wsl" style="whiteSpace=wrap;html=1;shape=process;size=0.041;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;git&lt;/b&gt;&lt;br&gt;worktrees &amp;middot; the pre-push hook lives in the repo, not here" vertex="1">
          <mxGeometry height="64" width="340" x="20" y="124" as="geometry" />
        </mxCell>
        <mxCell id="p1_gh" parent="p1_wsl" style="whiteSpace=wrap;html=1;shape=process;size=0.041;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;gh&lt;/b&gt;&amp;nbsp;&amp;nbsp;authenticated as the human&lt;br&gt;&lt;i&gt;reachable by the runner; the worker is handed an empty GH_CONFIG_DIR&lt;/i&gt;" vertex="1">
          <mxGeometry height="64" width="340" x="380" y="124" as="geometry" />
        </mxCell>
        <mxCell id="p1_home" parent="p1_wsl" style="whiteSpace=wrap;html=1;shape=process;size=0.02;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;/home/KMc&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;one OS user for human and worker alike&lt;/i&gt;&lt;br&gt;~/.claude/projects/&amp;lt;sandbox-slug&amp;gt;/&amp;lt;session&amp;gt;.jsonl &amp;mdash; the worker&#39;s transcript&lt;br&gt;~/.config/gh/hosts.yml &amp;middot; ~/.claude/.credentials &amp;mdash; readable by anything this user runs" vertex="1">
          <mxGeometry height="96" width="700" x="20" y="208" as="geometry" />
        </mxCell>
        <mxCell id="p1_mount" parent="1" style="swimlane;html=1;startSize=26;whiteSpace=wrap;fillColor=default;strokeColor=default;fontColor=default;swimlaneFillColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;drvfs / 9p&lt;/b&gt;&amp;nbsp;&amp;nbsp;D:\claudette&amp;nbsp;&amp;nbsp;&amp;#8646;&amp;nbsp;&amp;nbsp;/mnt/claudette&amp;nbsp;&amp;nbsp;&lt;i&gt;and the same bytes again at /mnt/d/claudette &amp;mdash; case-insensitive, so a containment check must fold case and know both roots&lt;/i&gt;" vertex="1">
          <mxGeometry height="500" width="1420" x="560" y="470" as="geometry" />
        </mxCell>
        <mxCell id="p1_apex" parent="p1_mount" style="swimlane;html=1;startSize=26;whiteSpace=wrap;fillColor=default;strokeColor=default;fontColor=default;swimlaneFillColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;APEX REPO&lt;/b&gt;&amp;nbsp;&amp;nbsp;/mnt/claudette &amp;middot; git &amp;middot; branch feature/hb &amp;middot; origin = github.com/KMc-Arch/claudette" vertex="1">
          <mxGeometry height="440" width="1380" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_hb" parent="p1_apex" style="whiteSpace=wrap;html=1;shape=process;size=0.021;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;.hb-heartbeat/&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;tracked &amp;mdash; the machinery and its own contract&lt;/i&gt;&lt;br&gt;start.md &amp;middot; spec.md &amp;middot; plan.md &amp;middot; config.json &amp;middot; hb.py &amp;middot; runner.py&lt;br&gt;hb-guard.sh + hb-guard.py &amp;middot; prompt-worker.md &amp;middot; templates/ &amp;middot; win/ &amp;middot; tests/ &amp;middot; designs/" vertex="1">
          <mxGeometry height="110" width="660" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_state" parent="p1_apex" style="whiteSpace=wrap;html=1;shape=process;size=0.021;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;.hb-heartbeat/state/&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;untracked &amp;mdash; the runtime&lt;/i&gt;&lt;br&gt;GO &amp;middot; night.json &amp;middot; quota.json &amp;middot; last-tick&lt;br&gt;diag/ &amp;middot; log/hb.log &amp;middot; config.json (instance override)" vertex="1">
          <mxGeometry height="110" width="660" x="700" y="40" as="geometry" />
        </mxCell>
        <mxCell id="p1_codex" parent="p1_apex" style="whiteSpace=wrap;html=1;shape=process;size=0.021;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;.codex/&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;the governance the sandbox inherits&lt;/i&gt;&lt;br&gt;hooks: visibility &amp;middot; containment &amp;middot; gravity &amp;middot; remote-guard&lt;br&gt;explicit/scrub (patterns + the pre-push hook) &amp;middot; explicit/hb (the /hb shim) &amp;middot; statusline" vertex="1">
          <mxGeometry height="110" width="660" x="20" y="166" as="geometry" />
        </mxCell>
        <mxCell id="p1_mail" parent="p1_apex" style="whiteSpace=wrap;html=1;shape=process;size=0.021;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;~outbox/hb/&lt;/b&gt; &amp;middot; &lt;b&gt;~inbox/hb/&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;untracked; ~ is never tracked anywhere&lt;/i&gt;&lt;br&gt;the queue in, the outcomes out &amp;mdash; one pair at every root&lt;br&gt;materialized idempotently by hb.py install" vertex="1">
          <mxGeometry height="110" width="660" x="700" y="166" as="geometry" />
        </mxCell>
        <mxCell id="p1_sandbox" parent="p1_apex" style="swimlane;html=1;startSize=26;whiteSpace=wrap;fillColor=default;strokeColor=default;fontColor=default;swimlaneFillColor=default;align=center;verticalAlign=middle;fontSize=11;strokeWidth=3;" value="&lt;b&gt;SANDBOX&lt;/b&gt;&amp;nbsp;&amp;nbsp;.hb-heartbeat/sandbox/&amp;lt;ITEM&amp;gt;/ &amp;middot; a git worktree on hb/&amp;lt;ITEM&amp;gt; from a pinned base &amp;middot; made per item, removed at harvest &amp;mdash; kept only when the terminus was unexpected" vertex="1">
          <mxGeometry height="128" width="1340" x="20" y="292" as="geometry" />
        </mxCell>
        <mxCell id="p1_sb_io" parent="p1_sandbox" style="whiteSpace=wrap;html=1;shape=process;size=0.022;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;the worker&#39;s I/O&lt;/b&gt;&amp;nbsp;&amp;nbsp;.hb-heartbeat/state/PROMPT.md &amp;middot; RESULT/ &amp;middot; gh-empty/&lt;br&gt;.state/work/ &amp;mdash; the untracked half of the live work register, copied in read-only" vertex="1">
          <mxGeometry height="72" width="640" x="20" y="36" as="geometry" />
        </mxCell>
        <mxCell id="p1_sb_claude" parent="p1_sandbox" style="whiteSpace=wrap;html=1;shape=process;size=0.022;spacingLeft=22;spacingRight=22;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;.claude/settings.local.json&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;written per item by the runner&lt;/i&gt;&lt;br&gt;the deny overlay and the hb-guard hook line" vertex="1">
          <mxGeometry height="72" width="640" x="680" y="36" as="geometry" />
        </mxCell>
        <mxCell id="p1_cl_gh" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;KMc-Arch/claudette&lt;br&gt;branches hb/* &amp;middot; PRs" vertex="1">
          <mxGeometry height="140" width="320" x="560" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="p1_cl_api" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;the worker&#39;s model &amp;middot; the subscription window the quota gate is about" vertex="1">
          <mxGeometry height="140" width="320" x="940" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="p1_cl_roots" parent="1" style="whiteSpace=wrap;html=1;ellipse;shape=cloud;fillColor=default;strokeColor=default;fontColor=default;align=center;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;28 child projects&lt;/b&gt;&lt;br&gt;each a root of its own &amp;middot; sixteen are not separate repos, and those cannot be worked" vertex="1">
          <mxGeometry height="140" width="320" x="1320" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="p1_e_prop" edge="1" parent="1" source="p1_sb_claude" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;fontSize=10;dashed=1;dashPattern=8 8;strokeWidth=3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="p1_codex" value="merged onto the propagated settings; the hook line names the &lt;b&gt;live&lt;/b&gt; guard scripts, not the sandbox&#39;s copies">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="770" />
              <mxPoint x="1300" y="721" />
